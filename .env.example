# ============================================================================
# Shin Anti-Fraud System — пример конфигурации
# Скопируйте в .env:  cp .env.example .env
# Все переменные читаются классом Settings (backend/app/config/settings.py).
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Shin Anti-Fraud System"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=""

# CORS: адреса frontend, которым разрешены запросы (через запятую).
# Значение "*" разрешает всем — удобно для демо, недопустимо в проде.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Risk Engine — пороги решений (ТЗ §6)
# risk_score <= RISK_APPROVE_MAX              -> APPROVE
# RISK_APPROVE_MAX < score <= RISK_CHALLENGE_MAX -> CHALLENGE
# score > RISK_CHALLENGE_MAX                  -> BLOCK
# ---------------------------------------------------------------------------
RISK_APPROVE_MAX=30
RISK_CHALLENGE_MAX=70

# Граница уровня CRITICAL (сам уровень на решение не влияет, только на отображение)
RISK_CRITICAL_MIN=90

# ---------------------------------------------------------------------------
# Жёсткие политики поверх ML (ТЗ §6: бизнес-логика вне endpoint)
#
# Каждое правило задаёт МИНИМАЛЬНЫЙ Risk Score при срабатывании. Правила только
# поднимают оценку модели и никогда её не снижают.
#
# Зачем они нужны. Модель учится на истории и потому недооценивает редкие, но
# дорогие паттерны. Например, новое устройство при обычной сумме в домашней
# сети статистически почти безопасно — модель даёт ~1 балл, и это честно.
# Но политика банка требует в таком случае подтверждения владельца (SCA/3DS),
# независимо от того, что сказала модель.
#
# Поставьте RULES_ENABLED=false, чтобы увидеть чистый выход ML.
# ---------------------------------------------------------------------------
RULES_ENABLED=true

# Пароль на смену порогов в рантайме (POST /config/thresholds).
# Пустое значение — эндпоинт записи ВЫКЛЮЧЕН, и это умышленно безопасное
# значение по умолчанию: адресом, которым ставится approve_max=100,
# отключается блокировка любого мошенничества.
# Только ASCII: пароль передаётся заголовком X-Admin-Token, а HTTP-заголовки
# не переносят кириллицу.
CONFIG_ADMIN_TOKEN=

# Физически невозможное перемещение между соседними транзакциями
RULE_IMPOSSIBLE_TRAVEL_MIN_SCORE=75
# Страна из списка повышенного риска
RULE_HIGH_RISK_COUNTRY_MIN_SCORE=55
# Страна отличается от домашней (обычная зарубежная поездка)
RULE_UNUSUAL_COUNTRY_MIN_SCORE=40
# Незнакомое устройство — требуется подтверждение владельца
RULE_NEW_DEVICE_MIN_SCORE=35
# Всплеск частоты операций
RULE_VELOCITY_MIN_SCORE=60
RULE_VELOCITY_TXN_PER_HOUR=6
# Крупная операция на недавно открытом счёте
RULE_NEW_ACCOUNT_AMOUNT_MIN_SCORE=60
RULE_NEW_ACCOUNT_AMOUNT_RATIO=4.0

# ---------------------------------------------------------------------------
# Теневой режим
# ---------------------------------------------------------------------------
# Вторая конфигурация видит те же операции и выносит свои решения.
# Они никуда не уходят: ответ API от них не зависит, в историю и профиль
# клиента они не попадают. Считаются только расхождения — чтобы оценить
# последствия переключения до того, как оно затронет клиентов.
SHADOW_ENABLED=true

# Пустое значение — наследовать у основной конфигурации.
# SHADOW_APPROVE_MAX=4
# SHADOW_CHALLENGE_MAX=70
# SHADOW_CRITICAL_MIN=90

# По умолчанию тень проверяет самое неприятное открытие дашборда:
# четыре политики из шести не ловят ничего сверх модели, а трение
# добавляют. Тень считает на живом потоке, чего стоило бы их выключить.
SHADOW_RULES_ENABLED=false

# ---------------------------------------------------------------------------
# Machine Learning
# ---------------------------------------------------------------------------
MODEL_PATH=backend/models/fraud_model.joblib
METRICS_PATH=backend/models/model_metrics.json
# Аналитика по всему датасету для дашборда. Выгружается скриптом
# export_evaluation.py, приложением только читается.
EVALUATION_PATH=backend/models/evaluation.json
# Эталонное распределение признаков: с ним сравнивается живой поток.
# Снимается тем же проходом по датасету, что и аналитика.
FEATURE_BASELINE_PATH=backend/models/feature_baseline.json
DATASET_PATH=backend/data/raw/transactions.csv

# Сколько транзакций генерировать (ТЗ §5: ~100 000)
DATASET_ROWS=100000
DATASET_USERS=3000
DATASET_FRAUD_RATE=0.02
RANDOM_SEED=42

# Доля тестовой выборки
TEST_SIZE=0.2

# ---------------------------------------------------------------------------
# XAI
# ---------------------------------------------------------------------------
# Сколько факторов риска показывать (ТЗ §7: 3–5)
XAI_TOP_FACTORS=5
# Использовать SHAP, если библиотека установлена. false -> всегда встроенный explainer.
XAI_USE_SHAP=true

# ---------------------------------------------------------------------------
# Business Cost (ТЗ §10)
# ---------------------------------------------------------------------------
# Доля суммы транзакции, теряемая при пропущенном фроде (1.0 = теряем всю сумму)
COST_FRAUD_LOSS_RATIO=1.0
# Дополнительные операционные издержки на один случай фрода (chargeback, расследование)
COST_FRAUD_FIXED=25.0
# Стоимость ложной блокировки хорошего клиента (отток, поддержка)
COST_FALSE_BLOCK=120.0
# Стоимость лишней проверки/2FA для хорошего клиента (трение, часть отвалится)
COST_FALSE_CHALLENGE=12.0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Сколько последних транзакций держать в памяти для /stats и таблицы Dashboard
MAX_STORED_TRANSACTIONS=10000

# Идемпотентность POST /predict по transaction_id: повтор с тем же
# телом получает прежний ответ и не повторяет последствий — операция
# не попадает в историю дважды, профиль клиента не сдвигается.
IDEMPOTENCY_ENABLED=true
# Сколько последних операций помнить. Очень поздний повтор
# обработается заново — это граница, а не сюрприз.
MAX_IDEMPOTENCY_KEYS=5000

# Архив разметки аналитика. В отличие от остальных артефактов, его нельзя
# пересчитать заново: метки ставил человек. Дописывается построчно
# в JSON Lines, в репозиторий не попадает.
FEEDBACK_PATH=backend/data/feedback/labels.jsonl

# ---------------------------------------------------------------------
# LLM-ассистент риск-аналитика (брифинг §6)
# ---------------------------------------------------------------------
#
# Пишет клиенту, почему у него попросили подтверждение. Решение при этом
# принимает модель: ассистент только формулирует уже принятое и не может
# его изменить — ответ, противоречащий вердикту, отбрасывается.
#
# БЕЗ КЛЮЧА СИСТЕМА РАБОТАЕТ. Текст тогда собирается из тех же фактов
# без языковой модели, и в ответе честно стоит source=fallback.
#
# Ключ НИКОГДА не коммитится: этот файл — пример, настоящий ключ живёт
# в .env, который в .gitignore. На хостинге задаётся переменной окружения.
LLM_ENABLED=true
LLM_API_KEY=
# Формат chat completions — тот же у DeepSeek, OpenAI и большинства
# остальных, поэтому смена провайдера это две переменные, а не правка кода.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=12
LLM_MAX_TOKENS=220

# ---------------------------------------------------------------------
# Адаптивный порог по категории мерчанта (брифинг §6)
# ---------------------------------------------------------------------
#
# Выключен по умолчанию: выгруженная аналитика считается на одном пороге
# для всех операций, и включённый режим разошёлся бы с числами дашборда.
# Таблица подобранных порогов и измеренный эффект видны в любом случае:
# GET /config/adaptive.
ADAPTIVE_THRESHOLDS_ENABLED=false
