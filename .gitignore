# --- Runtime data ---
# Разметка аналитика: накапливается работающей системой, а не пишется
# разработчиком. В репозитории ей делать нечего, а потерять обидно —
# поэтому она на диске рядом, но не в истории.
backend/data/feedback/

# --- ML artifacts (перегенерируются скриптами) ---
backend/data/raw/*.csv
backend/models/*.joblib
backend/models/*.pkl
# model_metrics.json намеренно НЕ игнорируется: метрики — часть документации

